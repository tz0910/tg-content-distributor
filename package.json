    "db:seed": "tsx prisma/seed.ts",
    "backfill:covers": "tsx scripts/backfill-covers.ts",
    "worker": "tsx workers/index.ts",
    "worker:crawler": "tsx workers/crawler.worker.ts",
    "worker:telegram": "tsx workers/telegram.worker.ts",
    "worker:scheduler": "tsx workers/scheduler.worker.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.15.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.0",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.2.5",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.2",
    "next-auth": "5.0.0-beta.29",
    "rss-parser": "^3.13.0",
